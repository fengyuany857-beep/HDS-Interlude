FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim
RUN groupadd --gid 10001 hdsi && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin hdsi
WORKDIR /app
COPY deploy/discord-user-phase-f/package.runtime.json ./package.json
RUN npm install --omit=dev --ignore-scripts && npm audit --omit=dev --audit-level=high
COPY --from=build /app/lib ./lib
COPY deploy/discord-user-phase-f/runtime.js ./runtime.js
RUN mkdir /var/lib/hdsi-koishi && chown 10001:10001 /var/lib/hdsi-koishi
USER 10001:10001
VOLUME ["/var/lib/hdsi-koishi"]
CMD ["node", "runtime.js"]
